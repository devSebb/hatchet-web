# Optional. Leave empty to serve the WordPress snapshot in lib/content/generated/
# (refresh with `pnpm sync:wp`) — that is the default everywhere, including prod.
# Set to "mock" to serve the hand-written fixtures in lib/content/fixtures/.
CONTENT_SOURCE=
# Only needed if the source WordPress stops allowing anonymous REST reads. Use a
# WordPress Application Password (Users -> Profile), never an account password.
WORDPRESS_BASIC_AUTH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_BOOK_DEMO_FORM_ID=
NEXT_PUBLIC_HUBSPOT_SIGN_UP_FORM_ID=
NEXT_PUBLIC_HUBSPOT_NEWSLETTER_FORM_ID=
NEXT_PUBLIC_HUBSPOT_GUIDE_FORM_ID=
NEXT_PUBLIC_APP_LOGIN_URL=https://app.streamhatchet.com
# Public Mux playback ID for the homepage hero clip (Mux → Video → Assets →
# your asset → Playback IDs, policy: public). Leave empty to show the static
# hero image instead.
NEXT_PUBLIC_MUX_PLAYBACK_ID=

# ---------------------------------------------------------------------------
# Book a demo — request notification email
# (lib/booking/server/email.ts — UNMOUNTED, see the README in that directory)
#
# Nothing reads these today: the static export has no server to send from, so a
# demo request currently reaches nobody. Kept because the delivery code is kept.
#
# SECRET. Gmail account and App Password used to send the internal sales
# notification over SMTP. Use a Google App Password, never an account
# password. When either is unset the send is *skipped* — the demo request
# still succeeds and still returns 201; only the email is not sent.
# ---------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where the notification is delivered. Not secret. Defaults to GMAIL_USER
# when unset.
SALES_EMAIL=

# ---------------------------------------------------------------------------
# Book a demo — bookable slot generation (lib/booking/config.ts)
#
# None are secret and all have working defaults, so the feature runs with
# this whole block empty. Availability windows themselves (Mon-Fri
# 09:00-17:00 host-local) are in code, not env.
#
# NEXT_PUBLIC_, because slots are now generated in the browser — the site is a
# static export and there is no availability endpoint to call. Values and
# defaults are unchanged from the server-side DEMO_* variables these replace.
# They are inlined at build time, so changing one needs a rebuild + redeploy.
# ---------------------------------------------------------------------------
# IANA timezone the availability windows are expressed in. Default:
# America/New_York
NEXT_PUBLIC_DEMO_HOST_TZ=
# Length of a single demo, in minutes. Default: 30
NEXT_PUBLIC_DEMO_DURATION_MIN=
# Gap between consecutive start times, in minutes. Default: 30
NEXT_PUBLIC_DEMO_INTERVAL_MIN=
# Minimum lead time before the earliest bookable slot, in minutes.
# Default: 240 (4 hours)
NEXT_PUBLIC_DEMO_MIN_NOTICE_MIN=
# How many days ahead to offer slots. Default: 30
NEXT_PUBLIC_DEMO_DAYS_AHEAD=
