{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(./app/globals.css)",
      "Edit(./components/icons/iso-icons.tsx)",
      "Edit(./components/ui/**)",

      "Edit(./next.config.ts)",
      "Edit(./tsconfig.json)",
      "Edit(./package.json)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./eslint.config.mjs)",
      "Edit(./.prettierignore)",
      "Edit(./.env*)",
      "Read(./.env.local)",

      "Edit(./app/layout.tsx)",
      "Edit(./lib/config/site.ts)",
      "Edit(./lib/config/nav.ts)",
      "Edit(./lib/config/legal.ts)",
      "Edit(./lib/seo.ts)",
      "Edit(./app/sitemap.ts)",
      "Edit(./app/robots.ts)",

      "Edit(./lib/content/**)",
      "Edit(./scripts/**)",

      "Edit(./lib/booking/**)",
      "Edit(./components/booking/**)",

      "Edit(./components/forms/HubSpotForm.tsx)",
      "Edit(./components/sections/ContactForm.tsx)",
      "Edit(./components/layout/FooterNewsletter.tsx)",
      "Edit(./components/resources/GuideGate.tsx)",
      "Edit(./lib/hubspot.ts)",

      "Edit(./app/_unmounted/**)",

      "Edit(./infra/**)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./.ds-sync/**)",
      "Edit(./.design-sync/**)",
      "Edit(./ds-bundle/**)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push * main)",
      "Bash(git push * main:main)",
      "Bash(git push * HEAD:main)",
      "Bash(git checkout main:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch main:*)",
      "Bash(git switch -c:*)",
      "Bash(git branch:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase -i:*)",
      "Bash(git merge main:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(aws:*)",
      "Bash(gh secret:*)",
      "Bash(gh api:*)",
      "Bash(./scripts/deploy.sh production:*)",
      "Bash(pnpm sync:wp:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(./scripts/deploy.sh:*)", "Bash(rm:*)"],
    "allow": [
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm install:*)",
      "Bash(node scripts/design-lint.mjs:*)",
      "Bash(./scripts/check-format.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git revert:*)",
      "Bash(git restore:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/after-edit.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
