{
  "//": [
    "FOR THE TECHNICAL REVIEWER ONLY.",
    "",
    "Copy this to .claude/settings.local.json (git-ignored by Claude Code's own",
    "default ignore rules — verify with `git check-ignore .claude/settings.local.json`)",
    "to lift the editor guardrails on your own machine.",
    "",
    ".claude/settings.json denies writes to the design system, the build config,",
    "the booking subsystem, infrastructure and the content pipeline. That is",
    "correct for Mark, Alessandra and Estela and wrong for you: you are the person",
    "who has to change those files when they genuinely need changing.",
    "",
    "Claude Code merges settings.local.json over settings.json, and an `allow`",
    "rule beats a `deny` rule for the same path. So this file re-grants what the",
    "shared file removes, and only on your machine.",
    "",
    "Leave the hooks alone — the format-and-typecheck hook is useful to everyone.",
    "",
    "Do not commit settings.local.json. If it were committed, every editor would",
    "silently inherit full write access and nothing would warn anyone."
  ],
  "permissions": {
    "allow": [
      "Edit(./app/globals.css)",
      "Write(./app/globals.css)",
      "Edit(./components/ui/**)",
      "Write(./components/ui/**)",
      "Edit(./components/icons/iso-icons.tsx)",
      "Write(./components/icons/iso-icons.tsx)",
      "Edit(./next.config.ts)",
      "Write(./next.config.ts)",
      "Edit(./package.json)",
      "Write(./package.json)",
      "Edit(./tsconfig.json)",
      "Write(./tsconfig.json)",
      "Edit(./eslint.config.mjs)",
      "Write(./eslint.config.mjs)",
      "Edit(./app/layout.tsx)",
      "Write(./app/layout.tsx)",
      "Edit(./lib/config/site.ts)",
      "Write(./lib/config/site.ts)",
      "Edit(./lib/config/nav.ts)",
      "Write(./lib/config/nav.ts)",
      "Edit(./lib/config/legal.ts)",
      "Write(./lib/config/legal.ts)",
      "Edit(./lib/seo.ts)",
      "Write(./lib/seo.ts)",
      "Edit(./app/sitemap.ts)",
      "Write(./app/sitemap.ts)",
      "Edit(./app/robots.ts)",
      "Write(./app/robots.ts)",
      "Edit(./lib/content/**)",
      "Write(./lib/content/**)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./lib/booking/**)",
      "Write(./lib/booking/**)",
      "Edit(./components/booking/**)",
      "Write(./components/booking/**)",
      "Edit(./components/forms/**)",
      "Write(./components/forms/**)",
      "Edit(./lib/hubspot.ts)",
      "Write(./lib/hubspot.ts)",
      "Edit(./app/_unmounted/**)",
      "Write(./app/_unmounted/**)",
      "Edit(./infra/**)",
      "Write(./infra/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(aws:*)",
      "Bash(gh:*)",
      "Bash(./scripts/deploy.sh:*)",
      "Bash(pnpm sync:wp:*)"
    ]
  }
}
