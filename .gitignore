hero-card-*.svg

# design-sync build output (regenerated by .ds-sync/ tools)
ds-bundle/
dist/
.ds-sync/.cache/
.ds-sync/node_modules/

# scratch background prototype (not part of the app)
hatchet-background.html

# Visual QA output for scripts/optimize-images.mjs (regenerated, never committed)
qa/
