# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Markdown files
# Phase-0 scaffold artifacts. Never committed, and they contradict the
# finished site on typeface, palette, decoration, numbering, and copy case —
# they must not reach the editors as if they were current rules.
BUILD_PLAN.md
DESIGN.md
# Handover reports: contain Vercel project/org identifiers that have
# deliberately never been committed, plus a map of where the system is soft.
handoff-audit.md
handoff-investigation.md
static-export-spike.md
media-forms-composability.md
image-optimization.md
wordpress-images.md
seo-namespace.md
aws-migration.md

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# extracted asset exports (local scratch, not part of the app)
/svg-exports/
/svg-exports.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

